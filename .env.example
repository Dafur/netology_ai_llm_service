# Параметры YandexGPT
YANDEX_GPT_API_KEY=your-api-key
YANDEX_GPT_FOLDER_ID=your-folder-id
# YANDEX_GPT_MODEL=yandexgpt-lite
# YANDEX_GPT_MODEL_VERSION=latest
# YANDEX_GPT_TEMPERATURE=0.6
# YANDEX_GPT_MAX_TOKENS=1000
# YANDEX_GPT_TIMEOUT=20
# YANDEX_GPT_MAX_RETRIES=3
# YANDEX_GPT_SYSTEM_PROMPT=

# Логирование
LOG_LEVEL=INFO
LOG_CONSOLE_LEVEL=INFO
LOG_FILE_LEVEL=DEBUG
LOG_FILE=logs/app.log
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=5
LOG_TO_CONSOLE=true
LOG_TO_FILE=true
